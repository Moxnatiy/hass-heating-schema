{
  "name": "Котельня (демо)",
  "settings": {},
  "nodes": [
    { "id": "hp", "type": "heat_pump", "x": 0, "y": 160, "label": "Тепловий насос",
      "bindings": { "running": "input_boolean.demo_compressor", "flow_temp": "sensor.demo_supply_temperature",
                    "return_temp": "sensor.demo_return_temperature", "outdoor_temp": "sensor.demo_outdoor_temperature" } },
    { "id": "v3", "type": "valve_3way", "x": 280, "y": 140, "bindings": { "a_open": "input_boolean.demo_dhw_mode" } },
    { "id": "tank", "type": "dhw_tank", "x": 560, "y": 40, "params": { "heater": false },
      "bindings": { "temp_top": "sensor.demo_tank_top", "temp_bottom": "sensor.demo_tank_bottom" } },
    { "id": "tap", "type": "dhw_tap", "x": 780, "y": 60, "bindings": { "open": "input_boolean.demo_tap" } },
    { "id": "mains", "type": "cold_water_inlet", "x": 780, "y": 170 },
    { "id": "j1", "type": "junction", "x": 430, "y": 260 },
    { "id": "j2", "type": "junction", "x": 210, "y": 260 },
    { "id": "pump", "type": "pump", "x": 300, "y": 360, "label": "Насос підлоги",
      "bindings": { "running": "input_boolean.demo_heating_pump" } },
    { "id": "man", "type": "manifold", "x": 480, "y": 360, "params": { "outlets": 2 } },
    { "id": "ufh1", "type": "ufh", "x": 500, "y": 560, "rotation": 270, "flip": true, "label": "Кухня" },
    { "id": "ufh2", "type": "ufh", "x": 580, "y": 560, "rotation": 270, "flip": true, "label": "Вітальня" },
    { "id": "ev", "type": "expansion_vessel", "x": 190, "y": 320, "rotation": 180,
      "bindings": { "pressure": "sensor.demo_system_pressure" } },
    { "id": "sv", "type": "safety_valve", "x": 420, "y": 120, "params": { "set_pressure": 3 } },
    { "id": "drain", "type": "drain", "x": 470, "y": 20, "rotation": 180 },
    { "id": "outdoor", "type": "outdoor_sensor", "x": 0, "y": 20, "label": "Вулиця",
      "bindings": { "temperature": "sensor.demo_outdoor_temperature" } },
    { "id": "pressure", "type": "value", "x": 0, "y": 320, "label": "Тиск", "bindings": { "value": "sensor.demo_system_pressure" } }
  ],
  "pipes": [
    { "id": "p_hp_v3", "from": { "node": "hp", "port": "supply_out" }, "to": { "node": "v3", "port": "AB" }, "medium": "heating_supply" },
    { "id": "p_v3_tank", "from": { "node": "v3", "port": "A" }, "to": { "node": "tank", "port": "coil_in" }, "medium": "heating_supply" },
    { "id": "p_tank_j1", "from": { "node": "tank", "port": "coil_out" }, "to": { "node": "j1", "port": "e" }, "medium": "heating_return" },
    { "id": "p_j1_j2", "from": { "node": "j1", "port": "w" }, "to": { "node": "j2", "port": "e" }, "medium": "heating_return" },
    { "id": "p_j2_hp", "from": { "node": "j2", "port": "w" }, "to": { "node": "hp", "port": "return_in" }, "medium": "heating_return" },
    { "id": "p_j2_ev", "from": { "node": "j2", "port": "s" }, "to": { "node": "ev", "port": "connection" }, "medium": "heating_return" },
    { "id": "p_j1_sv", "from": { "node": "j1", "port": "n" }, "to": { "node": "sv", "port": "in" }, "medium": "heating_return" },
    { "id": "p_sv_drain", "from": { "node": "sv", "port": "discharge" }, "to": { "node": "drain", "port": "in" }, "medium": "drain" },
    { "id": "p_v3_pump", "from": { "node": "v3", "port": "B" }, "to": { "node": "pump", "port": "in" }, "medium": "heating_supply" },
    { "id": "p_pump_man", "from": { "node": "pump", "port": "out" }, "to": { "node": "man", "port": "supply_in" }, "medium": "heating_supply" },
    { "id": "p_man_j1", "from": { "node": "man", "port": "return_out" }, "to": { "node": "j1", "port": "s" }, "medium": "heating_return" },
    { "id": "p_l1_out", "from": { "node": "man", "port": "out_1" }, "to": { "node": "ufh1", "port": "in" }, "medium": "heating_supply" },
    { "id": "p_l1_ret", "from": { "node": "ufh1", "port": "out" }, "to": { "node": "man", "port": "ret_1" }, "medium": "heating_return" },
    { "id": "p_l2_out", "from": { "node": "man", "port": "out_2" }, "to": { "node": "ufh2", "port": "in" }, "medium": "heating_supply" },
    { "id": "p_l2_ret", "from": { "node": "ufh2", "port": "out" }, "to": { "node": "man", "port": "ret_2" }, "medium": "heating_return" },
    { "id": "p_hot", "from": { "node": "tank", "port": "hot_out" }, "to": { "node": "tap", "port": "in" }, "medium": "dhw" },
    { "id": "p_cold", "from": { "node": "mains", "port": "out" }, "to": { "node": "tank", "port": "cold_in" }, "medium": "cold_water" }
  ]
}
